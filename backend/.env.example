APP_NAME=FinSight
APP_DESCRIPTION=Financial Exposure Intelligence System backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATA_SOURCE=csv
# Optional: generated v3 ML reference population; leave empty for the v2 dataset.
ML_REFERENCE_DATA_DIR=
DATABASE_URL=sqlite:///./finsight.db
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL=INFO
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Authentication & Password Reset
AUTH_JWT_SECRET=change-this-development-secret-with-at-least-32-bytes
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173

# Email Delivery Provider ("console", "auto", "resend", or "smtp")
#
# LOCAL DEVELOPMENT (Recommended):
#   Set EMAIL_DELIVERY_PROVIDER=console
#   - Prints the clickable password-reset link directly in your backend terminal.
#   - Requires NO API key, NO domain verification, and NO external email service.
#   - Works with ANY email address (e.g. test accounts, local users).
#   - NEVER contacts Resend or SMTP servers.
#
# PRODUCTION / DEPLOYMENT:
#   Set EMAIL_DELIVERY_PROVIDER=resend (or "auto" with RESEND_API_KEY set)
#   - Requires RESEND_API_KEY and a verified custom domain at resend.com/domains.
#   - Note: Resend's free 'onboarding@resend.dev' domain will reject (HTTP 403)
#     any recipient other than your registered Resend account email.
EMAIL_DELIVERY_PROVIDER=console

# Option A: Resend API Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=FinSight

# Option B: SMTP Configuration (e.g. Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@finsight.app

# LLM & Copilot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
COPILOT_LLM_ENABLED=true
COPILOT_LLM_PROVIDER=auto
COPILOT_LLM_TIMEOUT_SECONDS=8
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
COPILOT_OLLAMA_MODEL=llama3.2
